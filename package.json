{
  "name": "@tauchun/viblect",
  "version": "0.1.10",
  "private": false,
  "description": "灵犀桥：连接 Vibe Coding 工具与 IM 机器人的双向智能网关服务。",
  "bin": {
    "vct": "bin/vible-gateway.js",
    "viblect": "bin/vible-gateway.js",
    "vible-gateway": "bin/vible-gateway.js",
    "vible-coding-tool": "bin/vible-gateway.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/src",
    "public",
    "bin",
    "README.md",
    "image.png",
    "image-1.png"
  ],
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:watch": "tsx watch src/server.ts",
    "feishu:ws": "tsx scripts/feishu-ws-bridge.ts",
    "qq:ws": "tsx scripts/qq-ws-bridge.ts",
    "codex:run": "tsx scripts/codex-task-runner.ts",
    "codex:watch": "tsx scripts/codex-global-watcher.ts",
    "install:check": "node scripts/install-runner.cjs",
    "install:check:unix": "bash scripts/install.sh",
    "install:check:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1",
    "publish:check": "node scripts/publish-safety-check.cjs",
    "release:update-readme": "node scripts/update-readme-release-record.cjs",
    "prepublishOnly": "npm run publish:check",
    "postpublish": "npm run release:update-readme",
    "prepack": "npm run build && npm run build:clean-maps && npm run publish:check",
    "build": "tsc -p tsconfig.json && npm run build:copy-assets",
    "test": "vitest run",
    "build:copy-assets": "node scripts/copy-runtime-assets.cjs",
    "build:clean-maps": "node scripts/clean-sourcemaps.cjs"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "@larksuiteoapi/node-sdk": "^1.52.0",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.3.3",
    "pino": "^9.7.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.18",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
